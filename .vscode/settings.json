{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.pythonInstallPath": "/usr/bin/python3",
  "idf.openOcdConfigs": [
    "board/esp32s3-builtin.cfg"
  ],
  
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32s3"
  },
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],
  "idf.flashType": "UART",
  "idf.port": "/dev/ttyS5",
  "idf.espIdfPath": "/opt/esp/idf",
  "idf.toolsPath": "/opt/esp"
}
